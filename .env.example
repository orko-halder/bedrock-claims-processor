# Copy to .env and fill in, then load it (e.g. `set -a; source .env; set +a`).
# .env itself is git-ignored; only this example is committed.

# S3 bucket holding claim documents (raw/) and policy documents (policies/).
CLAIMS_BUCKET=your-bucket-name

# AWS region for Bedrock and S3.
AWS_REGION=us-east-1
